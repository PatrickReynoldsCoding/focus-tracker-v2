<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Session alerts on time (AlarmScheduler). Android 12-12L: the user can switch exact alarms off, then we use an alarm-clock alarm. 13+: USE_EXACT_ALARM is granted at install. Android 11 needs neither. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Updates from inside the app (Updater.kt): downloads the release APK from GitHub and hands it to Android's installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The widgets' minute tick (WidgetTicker.kt, D69): set again after the phone starts; skipped when offline. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".FocusApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.FocusTracker"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SetupActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".QuickAddActivity" android:exported="false" android:theme="@style/Theme.FocusTracker.Dialog"
            android:excludeFromRecents="true" android:taskAffinity="" android:windowSoftInputMode="stateVisible" />
        <!-- What Android's installer says about an update, and the note shown after one. -->
        <receiver android:name=".UpdateReceiver" android:exported="false" />
        <receiver android:name=".UpdatedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <!-- The widgets' minute tick while the screen is on (WidgetTicker.kt, D69), and setting it again after a restart or an update. -->
        <receiver android:name=".WidgetTickReceiver" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Each widget's settings (its profile; what the Files and Single file widgets show): asked when one is added, and from its ⚙ or a long press. Exported: the launcher opens it. -->
        <activity android:name=".WidgetSetupActivity" android:exported="true" android:taskAffinity="" android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- A Files widget row's tap: tick a to-do's item or open the file (WidgetTap.kt). Shows nothing. -->
        <activity android:name=".WidgetTapActivity" android:exported="false" android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity="" android:excludeFromRecents="true" android:noHistory="true" />
        <receiver android:name=".FilesWidget" android:exported="false" android:label="@string/files_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/files_widget_info" />
        </receiver>
        <receiver android:name=".SingleFileWidget" android:exported="false" android:label="@string/file_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/file_widget_info" />
        </receiver>
        <receiver android:name=".TodayWidget" android:exported="false" android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_widget_info" />
        </receiver>
    </application>
</manifest>
