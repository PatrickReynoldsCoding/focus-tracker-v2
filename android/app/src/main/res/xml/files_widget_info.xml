<?xml version="1.0" encoding="utf-8"?>
<!-- Files widget: a folder's or a tag's files. Set up on adding (WidgetSetupActivity) and again from ⚙ or a long press (12+). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="180dp"
    android:targetCellWidth="2"
    android:targetCellHeight="3"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_files"
    android:previewLayout="@layout/widget_files"
    android:configure="com.patrickreynolds.focustracker.WidgetSetupActivity"
    android:widgetFeatures="reconfigurable"
    android:description="@string/files_widget_description"
    android:widgetCategory="home_screen" />
