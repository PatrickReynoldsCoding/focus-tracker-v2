{
  "name": "focus-tracker",
  "version": "0.27.0",
  "description": "Focus Tracker v2: a personal focus, projects and habits tracker on Cloudflare Workers + D1, editable by Claude through its own MCP connector.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "test": "vitest run && node --test scripts/v1-map.test.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "pretest": "npm run build",
    "import:v1": "node scripts/import-v1.mjs",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@excalidraw/excalidraw": "^0.18.1",
    "dompurify": "^3.4.18",
    "hono": "^4.13.19",
    "marked": "^18.2.1",
    "preact": "^11.2.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.6.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sortablejs": "^1.15.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sortablejs": "^1.15.9",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  },
  "private": true,
  "type": "module"
}
