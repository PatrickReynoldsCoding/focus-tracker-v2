{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "focus-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/auth/*", "/authorize", "/oauth/*", "/register", "/.well-known/*", "/health"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "focus-tracker", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
